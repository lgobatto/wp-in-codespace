# Database Configuration
DB_HOST=mariadb
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=wp_password
DB_ROOT_PASSWORD=root_password

# Environment
ENVIRONMENT=development

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300

# Nginx Configuration
NGINX_PORT=80

# MariaDB Configuration
MYSQL_PORT=3306